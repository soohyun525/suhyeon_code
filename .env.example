# ── AI interpretation (Anthropic Claude) ─────────────────────────────
# Get a key at https://console.anthropic.com/. Without it, the app still
# runs and returns a templated (non-AI) fallback reading for local demos.
ANTHROPIC_API_KEY=

# ── Payments (Stripe) ────────────────────────────────────────────────
# Test mode keys are fine: https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY the app runs in "demo unlock" mode — the
# detailed reading is unlocked without a real charge (for local testing).
STRIPE_SECRET_KEY=

# Price of the detailed reading, in the smallest currency unit (USD cents).
DETAILED_READING_PRICE_CENTS=900
DETAILED_READING_CURRENCY=usd

# Public base URL used to build Stripe success/cancel redirect URLs.
# Optional — falls back to the request origin if unset.
NEXT_PUBLIC_BASE_URL=
