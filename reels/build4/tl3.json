{
 "duration": 70.88589473684208,
 "lines": [
  {
   "id": "n1",
   "say": "에이아이 시대",
   "s": 0.45,
   "dur": 1.1394736842105262,
   "who": "n"
  },
  {
   "id": "n2",
   "say": "유쾌하다고",
   "s": 1.8894736842105262,
   "dur": 1.0078947368421054,
   "who": "n"
  },
  {
   "id": "l1",
   "who": "c",
   "s": 4.2,
   "dur": 2.354,
   "say": "AI 콘텐츠와 AI 인플루언서가 범람하는 시대."
  },
  {
   "id": "l2",
   "who": "c",
   "s": 6.714,
   "dur": 3.223,
   "say": "처음엔 너무 쉽게들 돈 버는 거 아닌가 했는데, 이젠 안 하면 바보 되는 것 같음."
  },
  {
   "id": "l3",
   "who": "b",
   "s": 10.097000000000001,
   "dur": 2.625,
   "say": "제 느낌은, 약간 불쾌한 지점 지나서, 유쾌해짐."
  },
  {
   "id": "l4",
   "who": "b",
   "s": 13.632000000000001,
   "dur": 2.53,
   "say": "요즘 할머니가 픽시 자전거 타고 가게 가는 거, 재밌더라고요."
  },
  {
   "id": "l5",
   "who": "b",
   "s": 16.322000000000003,
   "dur": 2.425,
   "say": "근데 AI인데 아닌 척하면, 전 좀 별론 거 같아요."
  },
  {
   "id": "l6",
   "who": "c",
   "s": 18.907000000000004,
   "dur": 2.127,
   "say": "사랑꾼인 척했다가, 아닌 거 알게 되면 나락 가듯."
  },
  {
   "id": "l7",
   "who": "c",
   "s": 21.194000000000003,
   "dur": 1.309,
   "say": "대놓고 AI인 게 더 낫다!"
  },
  {
   "id": "l8",
   "who": "c",
   "s": 23.413000000000004,
   "dur": 3.101,
   "say": "저는 강아지가 말하고, 사람 훈육시키는 영상이 최애입니다."
  },
  {
   "id": "l9",
   "who": "c",
   "s": 26.674000000000003,
   "dur": 3.059,
   "say": "스톱! 나 밥 먹잖아! 이러고 주인 훈육시킴."
  },
  {
   "id": "l10",
   "who": "a",
   "s": 29.893000000000004,
   "dur": 3.69,
   "say": "저는 AI 병맛 드라마요. 너무 잘 만드니까 재미나더라고요!"
  },
  {
   "id": "l11",
   "who": "a",
   "s": 34.493,
   "dur": 2.986,
   "say": "하지만 어느 임계점에 도달하면, 인간을 찾을 수도 있겠다 싶긴 합니다."
  },
  {
   "id": "l12",
   "who": "b",
   "s": 37.638999999999996,
   "dur": 2.246,
   "say": "이런 걸 보고 자라는 십대들은, 어떻게 받아들일지."
  },
  {
   "id": "l13",
   "who": "a",
   "s": 40.044999999999995,
   "dur": 3.583,
   "say": "제 조카가 여덟 살인데, AI 콘텐츠랑 인간 콘텐츠를 구분하지 않더라고요."
  },
  {
   "id": "n3",
   "say": "재밌으면, 그냥, 본다.",
   "s": 44.03799999999999,
   "dur": 1.4026315789473682,
   "who": "n"
  },
  {
   "id": "l14",
   "who": "a",
   "s": 46.69063157894736,
   "dur": 3.008,
   "say": "AI를 믿고, 글쓰기 수준이 더 형편없어지는 것 같은 느낌."
  },
  {
   "id": "l15",
   "who": "a",
   "s": 49.85863157894736,
   "dur": 1.628,
   "say": "그래서 글쓰기 수업을 찾아다니는 중입니다."
  },
  {
   "id": "l16",
   "who": "c",
   "s": 51.64663157894736,
   "dur": 2,
   "say": "글쓰기에 대해 오히려 갈망 생기는 것도 맞아요."
  },
  {
   "id": "l17",
   "who": "b",
   "s": 53.80663157894735,
   "dur": 2.194,
   "say": "그래서 점점, 사람이 잘 쓰는 게 중요한 거 같아요."
  },
  {
   "id": "l18",
   "who": "c",
   "s": 56.91063157894735,
   "dur": 2.631,
   "say": "근데 글을 써서 서로 읽어보면, 성격이 다 나와서 부끄러움."
  },
  {
   "id": "l19",
   "who": "a",
   "s": 59.70163157894735,
   "dur": 1.208,
   "say": "제 글은 항상 팩트 중심."
  },
  {
   "id": "l20",
   "who": "c",
   "s": 61.069631578947345,
   "dur": 1.501,
   "say": "난 왜 이리, 단무지인 걸까."
  },
  {
   "id": "n4",
   "say": "룰 식스",
   "s": 63.180631578947335,
   "dur": 0.7447368421052631,
   "who": "n"
  },
  {
   "id": "n5",
   "say": "에이아이 쓸수록, 내 글이 고프다.",
   "s": 64.2753684210526,
   "dur": 2.0605263157894735,
   "who": "n"
  }
 ],
