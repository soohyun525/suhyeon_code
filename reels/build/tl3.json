{
 "duration": 61.094631578947315,
 "lines": [
  {
   "id": "n1",
   "say": "모든 회의를 녹음하는 회사?",
   "s": 0.45,
   "dur": 1.7973684210526315,
   "who": "n"
  },
  {
   "id": "n2",
   "say": "그리고 정확히, 이십이 분 뒤.",
   "s": 2.5473684210526315,
   "dur": 1.7973684210526315,
   "who": "n"
  },
  {
   "id": "l1",
   "who": "c",
   "s": 5.444736842105263,
   "dur": 5.383,
   "say": "모든 회의를 녹음해서, AI 에이전트들이 히스토리를 공유받는 회사들이 있다는데요! 다들 해보고 싶은지?"
  },
  {
   "id": "l2",
   "who": "a",
   "s": 10.987736842105264,
   "dur": 1.944,
   "say": "오오! 저는 써보고 싶어요!"
  },
  {
   "id": "l3",
   "who": "c",
   "s": 13.841736842105263,
   "dur": 2.269,
   "say": "진짜 오프 더 레코드는, 녹음기 끄고 하게 되겠네요."
  },
  {
   "id": "l4",
   "who": "c",
   "s": 16.27073684210526,
   "dur": 1.819,
   "say": "약간, 매일 연극하는 분위기일지도."
  },
  {
   "id": "l5",
   "who": "a",
   "s": 18.99973684210526,
   "dur": 1.391,
   "say": "직내괴도 많이 없어질 것 같아요."
  },
  {
   "id": "l6",
   "who": "c",
   "s": 20.550736842105263,
   "dur": 2.352,
   "say": "바로 직내괴 감지! 인사팀 자동 발송!"
  },
  {
   "id": "l7",
   "who": "c",
   "s": 23.062736842105263,
   "dur": 1.618,
   "say": "이거, 오히려 꿀일지도?"
  },
  {
   "id": "l8",
   "who": "b",
   "s": 25.59073684210526,
   "dur": 2.74,
   "say": "이미 사내에 거의 대부분의 분들이, 녹음기 켜고 회의 들어오시던데요?"
  },
  {
   "id": "l9",
   "who": "c",
   "s": 28.49073684210526,
   "dur": 0.876,
   "say": "아, 진짜요?"
  },
  {
   "id": "n3",
   "say": "이미, 다들, 녹음 중.",
   "s": 29.77673684210526,
   "dur": 1.2710526315789474,
   "who": "n"
  },
  {
   "id": "l10",
   "who": "b",
   "s": 32.297789473684205,
   "dur": 2.449,
   "say": "근데 뭐, 회의는 공적이라. 저도 사실 켜고."
  },
  {
   "id": "l11",
   "who": "a",
   "s": 34.9067894736842,
   "dur": 0.37,
   "say": "잡았다!"
  },
  {
   "id": "l12",
   "who": "c",
   "s": 35.43678947368419,
   "dur": 1.574,
   "say": "원래 녹음 전에 알려주는 게 매너인데."
  },
  {
   "id": "l13",
   "who": "a",
   "s": 37.92078947368419,
   "dur": 3.565,
   "say": "남편도 그래요. 요즘 누가 회의록 쓰냐, 녹음해서 딸깍이지."
  },
  {
   "id": "l14",
   "who": "c",
   "s": 41.64578947368418,
   "dur": 2.12,
   "say": "나만 바보 만들지 말고, 좀 알려줘라!"
  },
  {
   "id": "l15",
   "who": "b",
   "s": 44.675789473684176,
   "dur": 1.409,
   "say": "엥? 두 분 다 안 썼어요?"
  },
  {
   "id": "l16",
   "who": "a",
   "s": 46.24478947368417,
   "dur": 1.731,
   "say": "허락 없이 녹음하는 거, 맘에 걸려요."
  },
  {
   "id": "l17",
   "who": "b",
   "s": 48.13578947368417,
   "dur": 3.355,
   "say": "회의, 녹음, 클로드 전달. 개발이랑 문서 둘 다 딸깍인데."
  },
  {
   "id": "l18",
   "who": "c",
   "s": 51.65078947368416,
   "dur": 0.997,
   "say": "착한 아이 컴플렉스인가?"
  },
  {
   "id": "n4",
   "say": "룰 넘버 파이브.",
   "s": 53.257789473684156,
   "dur": 1.1394736842105262,
   "who": "n"
  },
  {
   "id": "n5",
   "say": "몰래 딸깍 말고, 말하고 딸깍.",
   "s": 54.74726315789468,
   "dur": 1.7973684210526315,
   "who": "n"
  }
 ],
